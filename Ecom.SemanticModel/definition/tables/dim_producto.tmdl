	column categoria
		dataType: string
		lineageTag: 69b65a32-ea8e-501d-b2d5-8245862270b6
		summarizeBy: none
		sourceColumn: categoria

		annotation SummarizationSetBy = Automatic

	column precio_lista
		dataType: double
		lineageTag: 0f12e8c8-f3fc-5e1f-ac39-22f24ea49799
		summarizeBy: none

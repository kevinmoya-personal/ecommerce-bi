table dim_producto
	lineageTag: 4243f314-a4c5-55f8-8713-64faf5cd041e

	column producto_id
		dataType: string
		isKey
		lineageTag: cc6b6a0c-17ce-5fd6-951b-835da8b5ba7a
		summarizeBy: none
		sourceColumn: producto_id

		annotation SummarizationSetBy = Automatic

	column producto
		dataType: string
		lineageTag: 7646cf0b-ae7d-56ee-bb1d-e5727ee93e8d
		summarizeBy: none
		sourceColumn: producto


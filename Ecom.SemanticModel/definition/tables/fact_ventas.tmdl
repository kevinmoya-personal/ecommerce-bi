	partition fact_ventas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(DataPath & "fact_ventas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"pedido_id", type text}, {"fecha", type date}, {"cliente_id", type text}, {"producto_id", type text}, {"canal", type text}, {"estado", type text}, {"cantidad", Int64.Type}, {"descuento_pct", type number}, {"ingreso", type number}, {"costo", type number}}, "en-US")
				in
				    Tipos
